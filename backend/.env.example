# Copy this file to backend/.env and replace values where needed.
# Never commit backend/.env or real credentials.
FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false 

# SMTP is required for verification and password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Optional Google OAuth. Configure this exact authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional GitHub OAuth. Add http://localhost:8000/auth/github/callback to callback URLs.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Optional LinkedIn OpenID Connect. Add http://localhost:8000/auth/linkedin/callback as redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Optional phone sign-in. Create a Twilio Verify Service and add its credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
